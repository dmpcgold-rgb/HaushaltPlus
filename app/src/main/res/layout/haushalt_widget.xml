<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="HAUSHALT+" android:textColor="#FF8629"
        android:textStyle="bold" android:textSize="15sp" />
    <TextView android:id="@+id/widget_summary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="Einkauf &amp; Aufgaben"
        android:textColor="#FFFFFF" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/widget_shopping"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center" android:text="Einkauf"
            android:contentDescription="Einkaufsliste öffnen"
            android:textColor="#FFFFFF" android:background="@drawable/widget_action"
            android:textSize="14sp" />
        <Space android:layout_width="8dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/widget_tasks"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center" android:text="Aufgaben"
            android:contentDescription="Aufgaben öffnen"
            android:textColor="#FFFFFF" android:background="@drawable/widget_action"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>