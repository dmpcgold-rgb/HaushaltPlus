rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() {
      return request.auth != null;
    }
    function membershipPath(homeId, userId) {
      return /databases/$(database)/documents/households/$(homeId)/members/$(userId);
    }
    function member(homeId) {
      return loggedIn() && exists(membershipPath(homeId, request.auth.uid));
    }
    function owner(homeId) {
      return loggedIn() && get(/databases/$(database)/documents/households/$(homeId)).data.ownerUid == request.auth.uid;
    }
    function validInvite(homeId, code) {
      return code is string && code.matches('^[A-F0-9]{20}$') &&
        exists(/databases/$(database)/documents/invites/$(code)) &&
        get(/databases/$(database)/documents/invites/$(code)).data.householdId == homeId &&
        get(/databases/$(database)/documents/invites/$(code)).data.active == true &&
        get(/databases/$(database)/documents/invites/$(code)).data.expiresAt > request.time;
    }
    match /users/{userId} {
      allow read, write: if loggedIn() && request.auth.uid == userId;
      match /homes/{homeId} {
        allow read, write: if loggedIn() && request.auth.uid == userId;
      }
    }
    match /invites/{code} {
      allow get: if loggedIn();
      allow list: if false;
      allow create: if loggedIn() && code.matches('^[A-F0-9]{20}$') &&
        request.resource.data.keys().hasOnly(['householdId', 'createdBy', 'active', 'createdAt', 'expiresAt']) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.active == true &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(30, 'd') &&
        member(request.resource.data.householdId);
      allow update, delete: if owner(resource.data.householdId);
    }
    match /households/{homeId} {
      allow create: if loggedIn() && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt']);
      allow get, list: if member(homeId);
      allow update: if owner(homeId) &&
        (request.resource.data.ownerUid == resource.data.ownerUid ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid']) &&
           exists(membershipPath(homeId, request.resource.data.ownerUid))));
      allow delete: if false;
      match /members/{userId} {
        allow read: if member(homeId);
        allow create: if loggedIn() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['name', 'joinedAt', 'notifyComplete', 'inviteCode']) &&
          request.resource.data.name is string &&
          (owner(homeId) || (request.resource.data.keys().hasAll(['inviteCode']) &&
            validInvite(homeId, request.resource.data.inviteCode)));
        allow update: if loggedIn() &&
          ((request.auth.uid == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'notifyComplete'])) || owner(homeId));
        allow delete: if (owner(homeId) || (loggedIn() && request.auth.uid == userId)) &&
          get(/databases/$(database)/documents/households/$(homeId)).data.ownerUid != userId;
      }
      match /shoppingLists/{listId} {
        allow read, write: if member(homeId);
      }
      match /shoppingItems/{itemId} {
        allow read, write: if member(homeId);
      }
      match /meals/{mealId} {
        allow read, write: if member(homeId);
      }
      match /templates/{templateId} {
        allow read, write: if member(homeId);
      }
      match /recipes/{recipeId} {
        allow read, write: if member(homeId);
      }
      match /receipts/{receiptId} {
        allow read, write: if member(homeId);
      }
      match /stockUsage/{usageId} {
        allow read, write: if member(homeId);
      }
      match /prices/{priceId} {
        allow read: if member(homeId);
        allow create: if member(homeId) &&
          request.resource.data.keys().hasOnly(['product', 'shop', 'unitPrice', 'unit', 'date', 'createdBy']) &&
          request.resource.data.product is string && request.resource.data.product.size() > 0 &&
          request.resource.data.product.size() <= 100 &&
          request.resource.data.shop is string && request.resource.data.shop.size() <= 100 &&
          request.resource.data.unitPrice is number &&
          request.resource.data.unitPrice > 0 && request.resource.data.unitPrice < 100000 &&
          request.resource.data.date is string &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if member(homeId);
      }
      match /checklists/{templateId} {
        allow read: if member(homeId);
        allow create: if member(homeId) &&
          request.resource.data.keys().hasOnly(['name', 'tasks', 'createdBy']) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.name is string && request.resource.data.name.size() <= 100 &&
          request.resource.data.tasks is list && request.resource.data.tasks.size() <= 80;
        allow update: if false;
        allow delete: if member(homeId);
      }
      match /trash/{trashId} {
        allow read: if member(homeId);
        allow create: if member(homeId) &&
          request.resource.data.keys().hasOnly(['type', 'label', 'payload', 'deletedAt', 'deletedBy']) &&
          request.resource.data.deletedBy == request.auth.uid &&
          request.resource.data.type in ['shopping', 'task', 'recipe', 'stock'] &&
          request.resource.data.label is string && request.resource.data.label.size() <= 120 &&
          request.resource.data.payload is string && request.resource.data.payload.size() <= 12000 &&
          request.resource.data.deletedAt is int && request.resource.data.deletedAt > 0;
        allow update: if false;
        allow delete: if member(homeId);
      }
      match /tasks/{taskId} {
        allow read, write: if member(homeId);
      }
      match /stock/{stockId} {
        allow read: if member(homeId);
        allow create, update: if member(homeId) &&
          request.resource.data.quantity is int &&
          request.resource.data.quantity >= 0 &&
          request.resource.data.quantity <= 1000000;
        allow delete: if member(homeId);
      }
      // Client-authored activity: only household members may read, and no member may forge another actor.
      match /activity/{eventId} {
        allow read: if member(homeId);
        allow create: if member(homeId) &&
          request.resource.data.keys().hasOnly(['actorUid', 'actorName', 'title', 'kind', 'createdAt']) &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.actorName is string &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 180 &&
          request.resource.data.kind in ['all', 'shopping', 'tasks', 'family', 'stock', 'receipt', 'recipe'] &&
          request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
      match /devices/{userId} {
        allow read: if false; // Admin SDK can still read for push delivery.
        allow create, update, delete: if member(homeId) && request.auth.uid == userId;
      }
    }
  }
}
